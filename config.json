{
  "video": {
    "width": 1080,
    "height": 1920,
    "fps": 30
  },
  "layout": {
    "question_font_size": 64,
    "question_y_position": 400,
    "answer_font_size": 48,
    "answer_y_start": 700,
    "answer_spacing": 150,
    "button_margin": 100,
    "button_height": 120,
    "button_radius": 20,
    "button_text_padding": 40,
    "timer_bar_height": 80
  },
  "appearance": {
    "color_scheme": "colorblind",
    "font_path": "assets/fonts/Roboto-Bold.ttf"
  },
  "audio": {
    "enabled": true,
    "engine": "piper",
    "voice_model": "assets/voices/en_US-libritts_r-medium.onnx",
    "speed": 0.7,
    "sample_rate": 22050,
    "background": {
      "enabled": true,
      "file": "assets/audio/ticking_converted.wav",
      "volume_with_voice": 0.15,
      "volume_without_voice": 0.35
    }
  },
  "timing": {
    "reveal_duration": 2.0,
    "transition_duration": 0.3,
    "think_duration": 2.0
  },
  "animation": {
    "question_fade_duration": 0.5,
    "answer_fade_duration": 0.3,
    "answer_delay_between": 0.3,
    "question_delay": 0.0
  },
  "input": {
    "quiz_file": "examples/daily_quiz.json"
  },
  "output": {
    "file": "quiz_video.mp4"
  }
}
